<odoo noupdate="1">

<!-- Create Refund -->
<record
        id="rma_supplier_policy_template_detail_create_refund"
        model="policy.template_detail"
    >
    <field name="template_id" ref="ssi_rma.rma_supplier_policy_template" />
    <field
            name="field_id"
            search="[('model_id.model','=','rma_supplier'),('name','=','create_refund_ok')]"
        />
    <field name="restrict_state" eval="0" />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field
            name="group_ids"
            eval="[(6,0,[ref('ssi_financial_accounting.refund_user_group')])]"
        />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if document.refund_ok:
    result = True
    </field>
</record>
</odoo>
